# Database
DATABASE_URL="postgresql://portal:portal_dev@localhost:5432/portal?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MeiliSearch
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_KEY="portal_meili_dev_key"

# Auth (generate with: openssl rand -base64 32)
AUTH_URL="http://localhost:3000"
AUTH_SECRET="change-me-in-production"

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID="your-client-id"
GITHUB_CLIENT_SECRET="your-client-secret"

# Public Social Links (optional)
NEXT_PUBLIC_GITHUB_URL="https://github.com/your-username"
NEXT_PUBLIC_X_URL="https://x.com/your-username"
NEXT_PUBLIC_EMAIL="your-email@your-site.com"

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_PUBLIC_URL="your-r2-public-url"

# Admin API Key (For local scripts and AI agents calling REST APIs)
ADMIN_API_KEY="your-admin-api-key"